{%- comment -%} TrapWin header + footer, drawn as part of each page's design. {%- endcomment -%}
{%- liquid
  assign mode = mode | default: 'nav'
  assign cdn = 'https://cdn.shopify.com/s/files/1/1118/2489/6338/files/'
  assign logo = ''
  if settings.logo
    assign logo = settings.logo | image_url: width: 1600
  endif
-%}
{%- if mode == 'nav' -%}
<style>
  html body .section-header,html body .shopify-section-group-header-group:has(.header-wrapper),html body .shopify-section-group-footer-group:has(footer.footer),html body .announcement-bar-section{display:none!important}
  html body:has(main .twh-bar) .shopify-section-group-header-group .twh-bar,html body:has(main .twh-bar) .shopify-section-group-header-group .twh-sheet{display:none!important}
  html body:has(main .twf) .shopify-section-group-footer-group .twf{display:none!important}
  .twh-bar{position:fixed;left:clamp(10px,1.6vw,22px);right:clamp(10px,1.6vw,22px);top:clamp(10px,1.6vw,18px);z-index:60;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:16px;height:clamp(66px,5.8vw,82px);padding:0 12px 0 16px;border-radius:16px;background:rgba(16,40,32,var(--hb,.28));-webkit-backdrop-filter:blur(18px) saturate(1.4);backdrop-filter:blur(18px) saturate(1.4);box-shadow:inset 0 1px 0 rgba(255,255,255,.12),0 18px 40px -24px rgba(0,0,0,.6);transition:background .25s}
  .twh-logo{justify-self:start;display:block;line-height:0}
  .twh-logo img{height:clamp(42px,4.4vw,60px);width:auto;max-width:46vw;object-fit:contain;filter:brightness(0) invert(1)}
  .twh-mid,.twh-end{display:flex;align-items:center;gap:4px}
  .twh-end{justify-self:end}
  html body .twh-bar a:not(#a):not(#b):not(#c):not(#d):not(#e):not(#f),html body .twh-bar button:not(#a):not(#b):not(#c):not(#d):not(#e):not(#f){appearance:none;border:0;background:transparent;cursor:pointer;display:inline-flex;align-items:center;gap:8px;height:44px;padding:0 14px;border-radius:12px;font-family:'Geist',system-ui,sans-serif!important;font-size:15px!important;font-weight:600!important;color:#fff!important;text-decoration:none!important;text-transform:none!important;letter-spacing:0!important;transition:background .15s}
  html body .twh-bar a:hover:not(#a):not(#b):not(#c):not(#d):not(#e):not(#f),html body .twh-bar button:hover:not(#a):not(#b):not(#c):not(#d):not(#e):not(#f){background:rgba(255,255,255,.12)}
  html body .twh-bar a.twh-cart:not(#a):not(#b):not(#c):not(#d):not(#e):not(#f){background:#ff6a2b!important;color:#173229!important;padding:0 16px}
  .twh-bar svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.8}
  html body .twh-bar .twh-n:not(#a):not(#b):not(#c):not(#d):not(#e):not(#f){min-width:20px;height:20px;padding:0 6px;border-radius:999px;background:#173229;color:#ffcfae!important;font-size:12px!important;display:inline-grid;place-items:center}
  .twh-bar a:focus-visible,.twh-bar button:focus-visible{outline:2px solid #fff;outline-offset:2px}
  .twh-menu{display:none}
  .twh-sheet{position:fixed;inset:0;z-index:59;display:none;flex-direction:column;justify-content:center;gap:6px;padding:100px 28px 40px;background:rgba(16,40,32,.72);-webkit-backdrop-filter:blur(24px);backdrop-filter:blur(24px)}
  .twh-sheet.on{display:flex}
  html body .twh-sheet a:not(#a):not(#b):not(#c):not(#d):not(#e):not(#f){font-family:'Archivo',system-ui,sans-serif!important;font-stretch:118%;font-weight:800!important;font-size:clamp(40px,12vw,64px)!important;line-height:1!important;letter-spacing:-.03em!important;text-transform:uppercase!important;color:#fff!important;text-decoration:none!important}
  @media(max-width:860px){.twh-mid{display:none}.twh-menu{display:inline-flex!important}.twh-bar{grid-template-columns:1fr auto}.twh-hide-s{display:none!important}}
</style>
<header class="twh-bar tw-own">
  <a class="twh-logo" href="/" aria-label="TrapWin home">{%- if logo != '' -%}<img src="{{ logo }}" alt="TrapWin" width="180" height="30">{%- else -%}TrapWin{%- endif -%}</a>
  <nav class="twh-mid" aria-label="Main">
    <a href="/collections/plugins">Plugins</a>
    <a href="/collections/plugins-fx">FX</a>
    <a href="/collections/plugins-instruments">Instruments</a>
  </nav>
  <div class="twh-end">
    <a class="twh-hide-s" href="/search" aria-label="Search"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg></a>
    <a class="twh-hide-s" href="/account" aria-label="Account"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/></svg></a>
    <a class="twh-cart" href="/cart"><svg viewBox="0 0 24 24"><path d="M5 7h14l-1.4 11H6.4z"/><path d="M9 7a3 3 0 016 0"/></svg>Cart{%- if cart.item_count > 0 -%}<span class="twh-n">{{ cart.item_count }}</span>{%- endif -%}</a>
    <button class="twh-menu" type="button" aria-expanded="false" aria-label="Menu"><svg viewBox="0 0 24 24"><path d="M4 8h16M4 16h16"/></svg></button>
  </div>
</header>
<div class="twh-sheet">
  <a href="/collections/plugins">Plugins</a><a href="/collections/plugins-fx">FX</a><a href="/collections/plugins-instruments">Instruments</a><a href="/search">Search</a><a href="/account">Account</a>
</div>
<script>
(function(){var s=document.currentScript.previousElementSibling,b=s.previousElementSibling,m=b.querySelector('.twh-menu');
if(m)m.addEventListener('click',function(){var on=!s.classList.contains('on');s.classList.toggle('on',on);m.setAttribute('aria-expanded',on)});
var t=false;addEventListener('scroll',function(){if(t)return;t=true;requestAnimationFrame(function(){t=false;b.style.setProperty('--hb',scrollY>40?.55:.28)})},{passive:true});})();
</script>
{%- else -%}
{%- liquid
  assign fbg = cdn | append: 'tyrol-1890-karersee.jpg?width=1800'
  if product
    case product.handle
      when 'trapwin-vice-boss'
        assign fbg = cdn | append: 'vb-hero2.jpg?width=1800'
      when 'alpine-theremin'
        assign fbg = cdn | append: 'tyrol-1890-karersee.jpg?width=1800'
      when 'omnicore-3000'
        assign fbg = cdn | append: 'omnicore-hero.jpg?width=1800'
    endcase
  endif
-%}
<style>
  .twf{position:relative;overflow:hidden;isolation:isolate;padding:clamp(80px,14vh,160px) clamp(20px,4vw,56px) 28px;color:#fff}
  .twf-bg{position:absolute;inset:0;z-index:-1}
  .twf-bg img{width:100%;height:100%;object-fit:cover;filter:blur(10px) saturate(1.1);transform:scale(1.08)}
  .twf-bg::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,var(--twf-top,rgba(16,40,32,0)) 0%,rgba(16,40,32,.35) 30%,rgba(16,40,32,.62) 100%)}
  .twf-grid{max-width:1400px;margin:0 auto;display:grid;grid-template-columns:1.4fr repeat(3,1fr);gap:clamp(20px,4vw,60px);align-items:start}
  html body .twf .twf-lead:not(#a):not(#b):not(#c):not(#d):not(#e):not(#f){margin:0!important;font-family:'Archivo',system-ui,sans-serif!important;font-stretch:118%;font-weight:800!important;font-size:clamp(28px,3vw,44px)!important;line-height:1!important;letter-spacing:-.03em!important;text-transform:uppercase!important;color:#fff!important}
  html body .twf .twf-sub:not(#a):not(#b):not(#c):not(#d):not(#e):not(#f){margin:14px 0 0!important;font-family:'Geist',system-ui,sans-serif!important;font-size:16px!important;line-height:1.5!important;color:rgba(255,255,255,.8)!important;max-width:34ch}
  html body .twf h3:not(#a):not(#b):not(#c):not(#d):not(#e):not(#f){margin:0 0 12px!important;font-family:'Geist',system-ui,sans-serif!important;font-size:13px!important;font-weight:600!important;color:rgba(255,255,255,.6)!important;text-transform:none!important;letter-spacing:0!important}
  .twf ul{list-style:none;margin:0;padding:0;display:grid;gap:8px}
  html body .twf li a:not(#a):not(#b):not(#c):not(#d):not(#e):not(#f){font-family:'Geist',system-ui,sans-serif!important;font-size:16px!important;font-weight:500!important;color:#fff!important;text-decoration:none!important}
  html body .twf li a:hover:not(#a):not(#b):not(#c):not(#d):not(#e):not(#f){text-decoration:underline!important;text-underline-offset:4px}
  .twf-mark{max-width:1400px;margin:clamp(48px,8vh,100px) auto 0;line-height:0}
  .twf-mark img{width:100%;height:auto;filter:brightness(0) invert(1);opacity:.95}
  .twf-base{max-width:1400px;margin:22px auto 0;display:flex;flex-wrap:wrap;justify-content:space-between;gap:10px}
  html body .twf-base span:not(#a):not(#b):not(#c):not(#d):not(#e):not(#f){font-family:'Geist',system-ui,sans-serif!important;font-size:13px!important;color:rgba(255,255,255,.7)!important}
  .twf a:focus-visible{outline:2px solid #fff;outline-offset:3px}
  @media(max-width:860px){.twf-grid{grid-template-columns:1fr 1fr}.twf-grid>div:first-child{grid-column:1/-1}}
</style>
<footer class="twf">
  <div class="twf-bg" aria-hidden="true"><img src="{{ fbg }}" alt="" loading="lazy"></div>
  <div class="twf-grid">
    <div>
      <p class="twf-lead">Plugins for producers.</p>
      <p class="twf-sub">VST3, AU and standalone for Windows and Mac. Pay once, download right after checkout.</p>
    </div>
    <div><h3>Shop</h3><ul><li><a href="/collections/plugins">All plugins</a></li><li><a href="/collections/plugins-fx">FX</a></li><li><a href="/collections/plugins-instruments">Instruments</a></li></ul></div>
    <div><h3>Help</h3><ul><li><a href="/pages/contact">Contact</a></li><li><a href="/account">Account</a></li><li><a href="/cart">Cart</a></li></ul></div>
    <div><h3>Legal</h3><ul>{%- for pol in shop.policies -%}<li><a href="{{ pol.url }}">{{ pol.title }}</a></li>{%- endfor -%}</ul></div>
  </div>
  {%- if logo != '' -%}<div class="twf-mark" aria-hidden="true"><img src="{{ logo }}" alt="" loading="lazy"></div>{%- endif -%}
  <div class="twf-base"><span>© {{ 'now' | date: '%Y' }} TrapWin</span><span>VST3 · AU · Standalone</span></div>
</footer>
{%- endif -%}
