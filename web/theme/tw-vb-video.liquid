{%- comment -%}
  VICE BOSS promo video block (rendered inside sections/tw-vb.liquid, right after the drive-in hero).
  Poster + one big gold play button; plays with sound on click, native controls after that.
{%- endcomment -%}
{%- assign cdn = 'https://cdn.shopify.com/s/files/1/1118/2489/6338/files/' -%}
<style>
  .vb-v{position:relative;padding:clamp(60px,10vh,120px) clamp(20px,4vw,64px);display:flex;flex-direction:column;align-items:center;gap:clamp(18px,3vh,32px)}
  html body .vbx .vb-v h2:not(#a):not(#b):not(#c):not(#d):not(#e):not(#f){margin:0!important;font-size:clamp(48px,6.5vw,110px)!important;line-height:.9!important;text-align:center;color:#fff!important}
  html body .vbx .vb-v h2 em:not(#a){font-style:normal;color:var(--gold)!important}
  .vb-v .frame{position:relative;width:min(1200px,92vw,calc((100svh - 220px) * 1.778));aspect-ratio:16/9;border-radius:14px;overflow:hidden;background:#000;box-shadow:0 0 0 1px rgba(255,204,51,.25),0 40px 120px rgba(255,46,136,.28),0 20px 40px rgba(0,0,0,.6)}
  .vb-v video{display:block;width:100%;height:100%;object-fit:cover;background:#000}
  .vb-v .play{position:absolute;inset:0;display:grid;place-items:center;border:0;padding:0;background:radial-gradient(60% 60% at 50% 50%,rgba(20,11,34,.15),rgba(20,11,34,.55));cursor:pointer}
  .vb-v .play span{width:clamp(84px,9vw,124px);aspect-ratio:1;border-radius:50%;display:grid;place-items:center;background:var(--gold);color:#1a0f00;box-shadow:0 0 0 10px rgba(255,204,51,.18),0 12px 50px rgba(255,204,51,.45);transition:transform .2s ease}
  .vb-v .play:hover span{transform:scale(1.06)}
  .vb-v .play svg{width:40%;height:40%;fill:currentColor;margin-left:6%}
  .vb-v .play:focus-visible span{outline:3px solid #fff;outline-offset:4px}
  .vb-v.on .play{display:none}
  html body .vbx .vb-v p:not(#a):not(#b):not(#c):not(#d):not(#e):not(#f){color:var(--mute)!important;font-size:17px!important;text-align:center}
</style>
<section class="vb-v" aria-label="Watch VICE BOSS">
  <h2 class="vd">Watch the <em>boss</em> work</h2>
  <div class="frame">
    <video preload="none" playsinline poster="{{ cdn }}vice-boss-promo-poster.jpg">
      <source src="{{ cdn }}vice-boss-promo.mp4" type="video/mp4">
    </video>
    <button class="play" type="button" aria-label="Play the VICE BOSS video"><span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></span></button>
  </div>
  <p class="vt">72 seconds. Sound on.</p>
</section>
<script>
(function(){
  var s=document.currentScript.previousElementSibling, v=s.querySelector('video'), b=s.querySelector('.play');
  b.addEventListener('click',function(){ s.classList.add('on'); v.controls=true; v.play(); });
})();
</script>
